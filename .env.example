# Variables de entorno para Chino Barber Shop
# Conexión a base de datos Turso Cloud (libSQL)
TURSO_DATABASE_URL=libsql://chinobarber-example.turso.io
TURSO_AUTH_TOKEN=tu_turso_auth_token_aqui

# Secreto para firma segura de tokens JWT (32+ caracteres)
JWT_SECRET=tu_secreto_super_seguro_jwt_aqui_2026

# Modo de ejecución (production / development)
NODE_ENV=development

# Google OAuth 2.0 (selector real de cuentas)
# En Google Cloud Console agrega como URI de redireccionamiento autorizado:
# http://localhost:3000/api/auth/google/callback (y tu dominio en producción)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
